# 统一换行：源码用 LF，Windows 脚本用 CRLF，避免跨平台提交出现整文件 diff
* text=auto eol=lf
*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.jar         binary
*.zip         binary
*.png         binary
*.pdf         binary
*.woff2       binary
