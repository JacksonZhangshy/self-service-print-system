# ============================================================
# 自助收费打印系统 · 后端镜像
# 多阶段构建：Maven 编译 → JRE 运行时（内置 LibreOffice 做页数换算）
# 构建：docker build -f deploy/Dockerfile.backend -t printsys/backend:1.1.0 .
# ============================================================

# ---------- 构建阶段 ----------
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src

# 先只拷 pom，让依赖层可缓存（改代码不必重下依赖）
COPY backend/pom.xml .
RUN mvn -B -q dependency:go-offline

COPY backend/src ./src
COPY backend/schema-mysql.sql ./
RUN mvn -B -q clean package -DskipTests \
    && cp target/print-system-1.1.0.jar /src/app.jar

# ---------- 运行阶段 ----------
FROM eclipse-temurin:17-jre-jammy

# LibreOffice 用于把 Word/Excel/PPT 转成 PDF 才能算真实页数；
# 中文字体必须装，否则转换出来的 PDF 是方块
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-writer libreoffice-calc libreoffice-impress \
        fonts-noto-cjk fonts-wqy-zenhei fontconfig \
        tzdata curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

# 与 systemd 部署保持一致的目录结构
RUN groupadd -r printsys && useradd -r -g printsys -d /opt/printsys printsys \
    && mkdir -p /opt/printsys/data/uploads /opt/printsys/logs \
    && chown -R printsys:printsys /opt/printsys

WORKDIR /opt/printsys/backend
COPY --from=build /src/app.jar ./print-system.jar

ENV SERVER_PORT=8080 \
    STORAGE_DIR=/opt/printsys/data/uploads \
    LOG_DIR=/opt/printsys/logs \
    SOFFICE_PATH=/usr/bin/soffice \
    JAVA_TOOL_OPTIONS="-Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -XX:MaxRAMPercentage=60"

USER printsys
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1

ENTRYPOINT ["sh", "-c", "exec java -jar /opt/printsys/backend/print-system.jar"]
