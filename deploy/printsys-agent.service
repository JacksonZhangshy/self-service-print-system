# ============================================================
# 自助收费打印系统 · 打印助手（Linux / CUPS 打印点）
# 仅当打印点是 Linux + CUPS 时才需要；Windows 打印点见 deploy/win/
# 安装：
#   sudo cp deploy/printsys-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now printsys-agent
# 日志：journalctl -u printsys-agent -f
# ============================================================
[Unit]
Description=Print System Agent (CUPS)
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=printsys
Group=printsys
WorkingDirectory=/opt/printsys/agent
EnvironmentFile=/opt/printsys/.env

# agent.json 与环境变量二选一，环境变量优先级更高
ExecStart=/opt/printsys/agent/PrintAgent
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=printsys-agent

[Install]
WantedBy=multi-user.target
