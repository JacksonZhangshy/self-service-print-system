# ============================================================
# 自助收费打印系统 · 前端镜像（Nginx 托管 SPA + 反代后端）
# 构建：docker build -f deploy/Dockerfile.frontend -t printsys/frontend:1.1.0 .
# ============================================================

# ---------- 构建阶段 ----------
FROM node:20-alpine AS build
WORKDIR /src

COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ---------- 运行阶段 ----------
FROM nginx:1.27-alpine

RUN rm -f /etc/nginx/conf.d/default.conf
# 容器内后端地址是服务名 backend，走 HTTP 80（TLS 由外层网关终止）
COPY deploy/nginx.docker.conf /etc/nginx/conf.d/printsys.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
