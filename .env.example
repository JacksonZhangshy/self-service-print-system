# ============================================================
# 自助收费打印系统 · 环境变量模板
# 用法：cp .env.example /opt/printsys/.env && chmod 600 /opt/printsys/.env
#      属主 root，由 systemd EnvironmentFile 读取
# 标注 【必改】 的项不填会导致启动失败或功能不可用
# ============================================================

# ---------- 基础 ----------
SERVER_PORT=8080
# 【必改】对外访问地址：支付回调、模拟支付页都用它拼接
PUBLIC_BASE_URL=https://print.example.com
STORAGE_DIR=/opt/printsys/data/uploads
LOG_DIR=/opt/printsys/logs
TZ=Asia/Shanghai

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=print_system
DB_USER=printsys
# 【必改】数据库口令
DB_PASSWORD=change-this-db-password

# ---------- 登录与鉴权 ----------
# 演示模式：true 时验证码直接返回给前端（仅本机演示，生产【必须】false）
DEMO_MODE=false
SESSION_TTL_HOURS=12
# 公共电脑防遗忘：无操作自动登出（分钟）
IDLE_MINUTES=15

# 【必改】管理员初始账号，仅在库里没有该账号时创建一次，之后请登录后台改密
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# 【必改】打印助手共享密钥，32 位以上随机串：openssl rand -hex 32
AGENT_TOKEN=

# ---------- 短信验证码 ----------
# log=只打日志（不可用于生产）/ aliyun / tencent / webhook
SMS_PROVIDER=aliyun
SMS_CODE_SALT=change-this-salt

# 阿里云短信
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 腾讯云短信（用腾讯云就填这组，SMS_PROVIDER=tencent）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# 自建短信网关（SMS_PROVIDER=webhook 时生效）
# 约定：POST {url}，JSON {phone, code, content}，Header Authorization: Bearer {token}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---------- 文档转换与计价 ----------
# 上传时用 LibreOffice 转 PDF 并按真实页数计价；生产【必须】true
CONVERT_ENABLED=true
# soffice 不在 PATH 时显式指定，如 /usr/lib/libreoffice/program/soffice
SOFFICE_PATH=
# 转换失败时是否允许按估算页数计价（宽松但可能少收钱，生产建议 false）
CONVERT_ALLOW_ESTIMATE=false

ORDER_EXPIRE_MINUTES=10
MAX_PAGES=500
TASK_CLAIM_TIMEOUT_MINUTES=15
TASK_MAX_RETRY=2
AUTO_REFUND_ON_FAILURE=true
FILE_RETENTION_DAYS=7
FILE_MAX_MB=100

# ---------- 支付 ----------
# 【必改】生产必须 false；true 表示可用模拟支付（无真实扣款，任何人可白打）
PAY_MOCK_ENABLED=false

# 支付宝当面付
ALIPAY_ENABLED=true
ALIPAY_APP_ID=
# 应用私钥（PKCS8，单行 PEM，换行写 \n）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（不是应用公钥）
ALIPAY_PUBLIC_KEY=
# 【必改】收款方 PID（2088 开头），回调会校验 seller_id 防止被换成别人的收款账号
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 微信支付 APIv3 Native
WECHAT_ENABLED=true
WECHAT_APP_ID=
WECHAT_MCH_ID=
# APIv3 密钥（32 位）
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_MERCHANT_SERIAL_NO=
# 商户私钥（apiclient_key.pem 内容）
WECHAT_PRIVATE_KEY=
# 微信支付平台证书（PEM，多个用换行分隔）。回调验签必须用到，
# 可用官方 wechatpay-java/证书下载工具获取，建议写进文件后由部署脚本注入
WECHAT_PLATFORM_CERTS=
