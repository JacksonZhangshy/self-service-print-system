{
  // ===== 打印助手配置（复制为 agent.json，与 PrintAgent.exe 同目录）=====
  // 所有字段都可以用环境变量覆盖，环境变量优先级更高，见 AgentConfig.cs 顶部注释。

  "ApiBaseUrl": "http://192.168.1.10:8080",
  "AgentToken": "请填写与后端 printsys.agent.token 一致的密钥",

  // 本打印点标识，多个打印点请勿重复
  "AgentId": "图书馆一楼-打印点01",

  // 终端号：必须与用户下单页面的 ?t= 参数一致（页面地址形如 http://host/?t=T01）。
  // 留空则本助手会领取所有终端的任务，多打印点部署时务必填写。
  "TerminalId": "T01",

  // 打印机名称，留空使用系统默认打印机。名称要与「设备和打印机」里完全一致。
  "PrinterName": "HP LaserJet Pro M404-M405",

  // SumatraPDF 路径，留空自动探测（PATH / Program Files / 程序目录 tools 下）
  "SumatraPdfPath": "",

  "PollSeconds": 3,
  "DownloadRetries": 3,

  // true = 以系统打印队列出队为成功依据（推荐）；false = 打印命令退出码 0 即成功
  "VerifyWithSpooler": true,
  "SpoolAppearTimeoutSeconds": 20,
  "SpoolFinishTimeoutSeconds": 180,
  "SpoolErrorGraceSeconds": 15,

  // 后端判定超时的任务不再打印，避免用户已退款却又出纸
  "SkipExpiredTask": true,

  "WorkDir": "",
  "LogDir": "",
  "LogRetentionDays": 14
}
